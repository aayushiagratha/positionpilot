      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.generation_run_id || String(body.generation_run_id).trim() === '') {\n  return [{ json: { _valid: false, _error: 'Missing required field: generation_run_id' } }];\n}\nreturn [{ json: { ...$input.first().json, _valid: true } }];"
      },
      "typeVersion": 2
    },
